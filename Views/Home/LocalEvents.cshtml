@model List<MunicipalServicesApp.Models.Event>

@{
    ViewData["Title"] = "Local Events and Announcements";

    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    string searchQuery = ViewBag.SearchQuery as string ?? "";
    string searchCategory = ViewBag.SearchCategory as string ?? "";
    string searchDate = ViewBag.SearchDate as string ?? "";
    string sortBy = ViewBag.SortBy as string ?? "";
}

<div class="container mt-5">
    <h2 class="text-primary animate__animated animate__fadeIn">Local Events &amp; Announcements</h2>

    <form method="get" class="row g-3 mt-3 mb-4" asp-action="LocalEvents" asp-controller="Home">
        <div class="col-md-4">
            <input type="text" name="searchQuery" class="form-control" placeholder="Search by Name"
                value="@searchQuery" />
        </div>

        <div class="col-md-3">
            <select name="searchCategory" class="form-control">
                <option value="">All Categories</option>
                @foreach (var cat in categories)
                {
                    if (string.Equals(cat, searchCategory, StringComparison.OrdinalIgnoreCase))
                    {
                        <option value="@cat" selected>@cat</option>
                    }
                    else
                    {
                        <option value="@cat">@cat</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-3">
            <input type="date" name="searchDate" class="form-control" value="@searchDate" />
        </div>

        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">Filter</button>
        </div>
    </form>

    <div class="row mb-3">
        <div class="col-md-4">
            <form method="get" class="d-flex" onsubmit="return applySortSubmit(this);">
                @* Keep other filters when sorting by including hidden fields *@
                <input type="hidden" name="searchQuery" value="@searchQuery" />
                <input type="hidden" name="searchCategory" value="@searchCategory" />
                <input type="hidden" name="searchDate" value="@searchDate" />

                <select name="sortBy" class="form-control" onchange="this.form.submit();">
                    @if (sortBy == "NameAsc")
                    {
                        <option value="NameAsc" selected>Name (A → Z)</option>
                    }
                    else
                    {
                        <option value="NameAsc">Name (A → Z)</option>
                    }

                    @if (sortBy == "NameDesc")
                    {
                        <option value="NameDesc" selected>Name (Z → A)</option>
                    }
                    else
                    {
                        <option value="NameDesc">Name (Z → A)</option>
                    }

                    @if (sortBy == "DateAsc")
                    {
                        <option value="DateAsc" selected>Date (Earliest)</option>
                    }
                    else
                    {
                        <option value="DateAsc">Date (Earliest)</option>
                    }

                    @if (sortBy == "DateDesc")
                    {
                        <option value="DateDesc" selected>Date (Latest)</option>
                    }
                    else
                    {
                        <option value="DateDesc">Date (Latest)</option>
                    }
                </select>
            </form>
        </div>
    </div>

    <table class="table table-striped table-hover animate__animated animate__fadeInUp">
        <thead class="table-primary">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Date</th>
                <th>Description</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Count > 0)
            {
                foreach (var ev in Model)
                {
                    <tr>
                        <td>@ev.Name</td>
                        <td>@ev.Category</td>
                        <td>@ev.Date.ToString("dd MMM yyyy")</td>
                        <td>@ev.Description</td>
                        <td>
                            <a href="@Url.Action("ViewEvent", "Home", new { id = ev.Id })" class="btn btn-sm btn-secondary">
                                View
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted">No events found.</td>
                </tr>
            }
        </tbody>
    </table>

    @* Recommended events (if controller populated ViewBag.RecommendedEvents) *@
    @if (ViewBag.RecommendedEvents is List<MunicipalServicesApp.Models.Event> recs && recs.Count > 0)
    {
        <div class="mt-4">
            <h4 class="text-success">Recommended for You</h4>
            <div class="row g-3 mt-2">
                @foreach (var r in recs)
                {
                    <div class="col-md-4">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">@r.Name</h5>
                                <p class="card-text">@r.Description</p>
                                <p class="text-muted"><strong>@r.Category</strong> • @r.Date.ToString("dd MMM yyyy")</p>
                                <a href="@Url.Action("ViewEvent", "Home", new { id = r.Id })"
                                    class="btn btn-sm btn-outline-primary">View</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // keep sorting simple: we submit the hidden form via onsubmit
        function applySortSubmit(form) {
            // nothing to do here; the form will submit and include hidden filter inputs
            return true;
        }
    </script>
}